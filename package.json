{
  "name": "@edkief/ralph",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Long-running agent loop that drives opencode through its HTTP API",
  "license": "MIT",
  "bin": {
    "ralph": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build -c web/vite.config.ts",
    "build:web": "vite build -c web/vite.config.ts",
    "dev": "node --experimental-strip-types src/cli.ts",
    "dev:web": "vite -c web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
